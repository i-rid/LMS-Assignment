<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer stroke with rounded corners -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="@color/lms_primary" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>

    <!-- Inner background with the image -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <bitmap
            android:src="@drawable/bg_ranks_forms"
            android:gravity="fill" />
    </item>
</layer-list>
