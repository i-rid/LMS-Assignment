<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".view.child_tabs.AFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <GridLayout
                android:id="@+id/layoutBigCards"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:columnCount="2"
                android:padding="16dp"
                android:rowCount="2"
                android:visibility="gone"
                tools:visibility="visible">

                <include
                    android:id="@+id/layoutBigCards1"
                    layout="@layout/layout_big_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp" />

                <include
                    android:id="@+id/layoutBigCards2"
                    layout="@layout/layout_big_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp" />

                <include
                    android:id="@+id/layoutBigCards3"
                    layout="@layout/layout_big_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="12dp" />

                <include
                    android:id="@+id/layoutBigCards4"
                    layout="@layout/layout_big_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1" />
            </GridLayout>

            <GridLayout
                android:id="@+id/layoutSmallCards"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:columnCount="2"
                android:padding="16dp"
                android:rowCount="2"
                android:visibility="gone"
                tools:visibility="visible">

                <include
                    android:id="@+id/layoutSmallCards1"
                    layout="@layout/layout_small_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="12dp" />

                <include
                    android:id="@+id/layoutSmallCards2"
                    layout="@layout/layout_small_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginBottom="12dp" />

                <include
                    android:id="@+id/layoutSmallCards3"
                    layout="@layout/layout_small_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="12dp" />

                <include
                    android:id="@+id/layoutSmallCards4"
                    layout="@layout/layout_small_cards"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_rowWeight="1"
                    android:layout_columnWeight="1" />
            </GridLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="675dp"
                android:background="@drawable/bg_top_players_long"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginVertical="16dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:text="TOP"
                        android:textColor="@color/lms_primary_bg"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:layout_marginStart="8dp"
                        android:text="PLAYERS"
                        android:textColor="@color/lms_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTopPlayers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:itemCount="1"
                        tools:listitem="@layout/item_top_players" />

                    <ProgressBar
                        android:id="@+id/playersProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/lms_primary" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:backgroundTint="@color/white"
                    android:text="VIEW ALL ->"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    app:cornerRadius="4dp"
                    app:strokeColor="#FFF14040"
                    app:strokeWidth="1dp" />
            </LinearLayout>


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="520dp"
                android:background="@drawable/bg_top_players"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:text="SQUAD"
                        android:textColor="@color/white"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:layout_marginStart="4dp"
                        android:text="LIST"
                        android:textColor="@color/lms_primary_txt"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvSquadList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_squad" />

                    <ProgressBar
                        android:id="@+id/squadProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/lms_primary" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp"
                    android:backgroundTint="@color/white"
                    android:paddingHorizontal="30sp"
                    android:text="VIEW ALL ->"
                    android:textColor="@color/black"
                    android:textSize="16sp"
                    app:cornerRadius="4dp"
                    app:strokeColor="#E44A4A"
                    app:strokeWidth="2dp" />
            </LinearLayout>

            <!--
                android:layout_height="1280dp"

            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_players_long"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:text="RECENT"
                        android:textColor="@color/lms_primary_bg"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="16dp"
                        android:layout_marginStart="8dp"
                        android:text="VIDEOS"
                        android:textColor="@color/lms_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvVideos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_video" />

                    <ProgressBar
                        android:id="@+id/videoProgressBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/lms_primary" />
                </FrameLayout>

                <com.google.android.material.button.MaterialButton
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="30dp"
                    android:layout_marginBottom="30dp"
                    android:backgroundTint="@color/lms_primary_dark"
                    android:text="VIEW MORE  -->"
                    android:textColor="@color/white"
                    app:cornerRadius="4dp"
                    app:strokeColor="#E44A4A"
                    app:strokeWidth="1dp" />

                <include
                    android:id="@+id/layoutDesc"
                    layout="@layout/layout_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="24dp" />

                <include
                    android:id="@+id/layoutHonours"
                    layout="@layout/layout_honours"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="24dp" />

                <include
                    android:id="@+id/layoutResults"
                    layout="@layout/item_recent_results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="24dp" />


            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>