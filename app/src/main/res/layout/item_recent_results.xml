<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="8dp"
    app:strokeColor="@color/lms_primary"
    app:strokeWidth="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="50dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:scaleType="fitXY"
                android:src="@drawable/bg_top_players" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="RECENT RESULTS"
                android:textColor="@color/white"
                android:textSize="20sp" />
        </FrameLayout>

        <include
            android:id="@+id/layoutResults0"
            layout="@layout/layout_recent_results_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/layoutResults1"
            layout="@layout/layout_recent_results_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/layoutResults2"
            layout="@layout/layout_recent_results_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/layoutResults3"
            layout="@layout/layout_recent_results_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/layoutResults4"
            layout="@layout/layout_recent_results_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/layoutResults5"
            layout="@layout/layout_recent_results_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:backgroundTint="@color/white"
            android:text="VIEW ALL -->"
            android:textColor="@color/lms_primary_dark"
            android:textSize="16sp"
            app:cornerRadius="5dp"
            app:strokeColor="@color/lms_primary"
            app:strokeWidth="1dp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>